{
  "name": "Cinema Showcase",
  "permissions": {
    "network": "Fetches schedules and artwork; shares authenticated poster downloads with configured LAN peers on TCP 18742"
  },
  "expand_schedules": true,
  "options": [
    {
      "title": "Primary info-beamer playlist",
      "ui_width": 8,
      "name": "interstitial_playlist",
      "type": "playlist",
      "hint": "Choose the first playlist to mix between movie posters",
      "doc_link": true
    },
    {
      "title": "Additional info-beamer playlists",
      "name": "additional_playlists",
      "type": "list",
      "itemname": "Playlist",
      "hint": "Add as many additional Hosted playlists as needed",
      "items": [
        {
          "title": "Playlist",
          "name": "playlist",
          "type": "playlist"
        }
      ]
    },
    {
      "title": "Display rotation",
      "ui_width": 4,
      "name": "rotation",
      "type": "select",
      "hint": "Rotate the complete output clockwise",
      "doc_link": true,
      "options": [
        [0, "None"],
        [90, "90° clockwise"],
        [180, "180°"],
        [270, "270° clockwise"]
      ],
      "default": 0
    },
    {
      "title": "Share posters over local network",
      "name": "peer_sharing",
      "type": "boolean",
      "default": true
    },
    {
      "title": "Nearby device IP addresses (comma separated)",
      "name": "peer_addresses",
      "type": "string",
      "default": ""
    },
    {
      "title": "Venue name",
      "name": "venue_name",
      "type": "string",
      "default": "Our Cinema"
    },
    {
      "title": "INDY site ID",
      "name": "indy_site_id",
      "type": "integer",
      "default": 352,
      "min": 1
    },
    {
      "title": "INDY upcoming feed",
      "name": "indy_feed_url",
      "type": "string",
      "default": "https://api-us.indy.systems/tms/upcoming_showings.xml"
    },
    {
      "title": "Campaign Manager feed URL",
      "name": "campaign_feed_url",
      "type": "string",
      "hint": "Paste only the plain Supabase/Lovable endpoint URL, without Markdown brackets or link formatting",
      "default": ""
    },
    {
      "title": "Campaign Manager API token",
      "name": "campaign_api_token",
      "type": "string",
      "ui_type": "password",
      "hint": "Optional function token or Supabase publishable key; never use a service-role key on a player",
      "default": ""
    },
    {
      "title": "Campaign artwork orientation",
      "name": "campaign_orientation",
      "type": "select",
      "hint": "Auto uses vertical artwork at 90°/270° and horizontal artwork at 0°/180°",
      "options": [
        ["auto", "Automatic from display rotation"],
        ["vertical", "Vertical poster (9:16)"],
        ["horizontal", "Horizontal artwork (16:9)"]
      ],
      "default": "auto"
    },
    {
      "title": "Ticket website base URL",
      "name": "ticket_base_url",
      "type": "string",
      "default": "https://flagshipcinemas.com"
    },
    {
      "title": "Venue timezone",
      "name": "venue_timezone",
      "type": "string",
      "default": "America/New_York"
    },
    {
      "title": "TMDB token (optional fallback)",
      "name": "tmdb_token",
      "type": "string",
      "ui_type": "password",
      "hint": "Used only when INDY or Campaign Manager supplies no artwork",
      "default": ""
    },
    {
      "title": "Feed refresh interval",
      "name": "refresh_minutes",
      "type": "integer",
      "default": 15,
      "min": 2,
      "max": 1440
    },
    {
      "title": "Movie slide duration",
      "name": "movie_duration",
      "type": "duration",
      "default": 12
    },
    {
      "title": "Playlist video audio",
      "name": "playlist_audio",
      "type": "boolean",
      "default": false
    },
    {
      "title": "Playlist media scaling",
      "name": "playlist_scaling",
      "type": "select",
      "hint": "Fit keeps the complete image centered; Fill crops it to cover the screen",
      "options": [
        ["fit", "Fit and center"],
        ["fill", "Fill screen (crop)"]
      ],
      "default": "fit"
    },
    {
      "title": "Coming Soon enabled",
      "name": "show_coming_soon",
      "type": "boolean",
      "default": true
    },
    {
      "title": "Catch It on the Big Screen enabled",
      "name": "show_leaving_soon",
      "type": "boolean",
      "hint": "On Tuesdays, highlights current movies without a Friday-or-later showing when other movies are scheduled then",
      "default": true
    },
    {
      "title": "Coming Soon horizon (days)",
      "name": "coming_soon_days",
      "type": "integer",
      "default": 90,
      "min": 1,
      "max": 365
    },
    {
      "title": "Show ticket QR codes",
      "name": "show_qr_codes",
      "type": "boolean",
      "default": true
    }
  ],
  "scratch_scope": "instance",
  "optional": [
    "README.md",
    "sample-campaign-feed.json",
    "sample-upcoming-showings.xml",
    "OFL.txt",
    "tests/.*"
  ]
}
