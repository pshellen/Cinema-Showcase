{
  "name": "Cinema Showcase",
  "permissions": {
    "network": "Fetches schedules and artwork; shares authenticated poster downloads with configured LAN peers on TCP 18742"
  },
  "expand_schedules": true,
  "options": [
    {
      "title": "Primary info-beamer playlist",
      "ui_width": 8,
      "name": "interstitial_playlist",
      "type": "playlist",
      "hint": "Choose the first playlist to mix between movie posters",
      "doc_link": true
    },
    {
      "title": "Additional info-beamer playlists",
      "name": "additional_playlists",
      "type": "list",
      "itemname": "Playlist",
      "hint": "Add as many additional Hosted playlists as needed",
      "items": [
        {
          "title": "Playlist",
          "name": "playlist",
          "type": "playlist"
        }
      ]
    },
    {
      "title": "Display rotation",
      "ui_width": 4,
      "name": "rotation",
      "type": "select",
      "hint": "Rotate the complete output clockwise",
      "doc_link": true,
      "options": [
        [0, "None"],
        [90, "90° clockwise"],
        [180, "180°"],
        [270, "270° clockwise"]
      ],
      "default": 0
    },
    {
      "title": "Share posters over local network",
      "name": "peer_sharing",
      "type": "boolean",
      "default": true
    },
    {
      "title": "Nearby device IP addresses (comma separated)",
      "name": "peer_addresses",
      "type": "string",
      "default": ""
    },
    {
      "title": "Venue name",
      "name": "venue_name",
      "type": "string",
      "default": "Our Cinema"
    },
    {
      "title": "INDY site ID",
      "name": "indy_site_id",
      "type": "integer",
      "default": 352,
      "min": 1
    },
    {
      "title": "INDY upcoming feed",
      "name": "indy_feed_url",
      "type": "string",
      "default": "https://api-us.indy.systems/tms/upcoming_showings.xml"
    },
    {
      "title": "Ticket website base URL",
      "name": "ticket_base_url",
      "type": "string",
      "default": "https://flagshipcinemas.com"
    },
    {
      "title": "Venue timezone",
      "name": "venue_timezone",
      "type": "string",
      "default": "America/New_York"
    },
    {
      "title": "TMDB API read token",
      "name": "tmdb_token",
      "type": "string",
      "ui_type": "password",
      "default": ""
    },
    {
      "title": "Feed refresh interval",
      "name": "refresh_minutes",
      "type": "integer",
      "default": 15,
      "min": 2,
      "max": 1440
    },
    {
      "title": "Movie slide duration",
      "name": "movie_duration",
      "type": "duration",
      "default": 12
    },
    {
      "title": "Playlist video audio",
      "name": "playlist_audio",
      "type": "boolean",
      "default": false
    },
    {
      "title": "Playlist media scaling",
      "name": "playlist_scaling",
      "type": "select",
      "hint": "Fit keeps the complete image centered; Fill crops it to cover the screen",
      "options": [
        ["fit", "Fit and center"],
        ["fill", "Fill screen (crop)"]
      ],
      "default": "fit"
    },
    {
      "title": "Coming Soon enabled",
      "name": "show_coming_soon",
      "type": "boolean",
      "default": true
    },
    {
      "title": "Coming Soon horizon (days)",
      "name": "coming_soon_days",
      "type": "integer",
      "default": 90,
      "min": 1,
      "max": 365
    },
    {
      "title": "Show ticket QR codes",
      "name": "show_qr_codes",
      "type": "boolean",
      "default": true
    },
    {
      "title": "Manual movie roster",
      "name": "manual_movies",
      "type": "list",
      "itemname": "Movie",
      "items": [
        {
          "title": "Movie title",
          "name": "title",
          "type": "string",
          "default": ""
        },
        {
          "title": "Start / release date",
          "name": "release_date",
          "type": "string",
          "default": "2026-01-01",
          "placeholder": "YYYY-MM-DD"
        },
        {
          "title": "TMDB ID override",
          "name": "tmdb_id",
          "type": "string",
          "default": "",
          "placeholder": "Optional"
        },
        {
          "title": "Rating",
          "name": "rating",
          "type": "string",
          "default": ""
        },
        {
          "title": "On sale",
          "name": "on_sale",
          "type": "boolean",
          "default": false
        },
        {
          "title": "Movie URL slug",
          "name": "url_slug",
          "type": "string",
          "default": "",
          "placeholder": "example-movie"
        },
        {
          "title": "Full ticket URL override",
          "name": "ticket_url",
          "type": "string",
          "default": "",
          "placeholder": "Optional https://..."
        }
      ]
    }
  ],
  "scratch_scope": "instance",
  "optional": [
    "README.md",
    "sample-upcoming-showings.xml",
    "OFL.txt",
    "tests/.*"
  ]
}
